{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crash Launcher",
  "version": "0.1.1",
  "identifier": "net.ghostesp.crash-launcher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Crash of the Titans Launcher",
        "width": 1040,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
